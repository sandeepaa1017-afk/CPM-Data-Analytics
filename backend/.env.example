APP_NAME=CPM Common API
APP_ENV=development
API_DOCS_ENABLED=true
DATABASE_URL=postgresql+psycopg://cpm_user:replace-with-a-local-password@postgres:5432/cpm_db
POSTGRES_PASSWORD=replace-with-a-local-password
CPM_DB_NAME=cpm_db
CPM_DB_USER=cpm_user
CPM_DB_PASSWORD=replace-with-a-local-password
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-local-password
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
